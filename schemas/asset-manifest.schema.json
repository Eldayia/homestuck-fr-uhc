{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eldayia/homestuck-fr-uhc/schemas/asset-manifest.schema.json",
  "title": "Homestuck FR local translated asset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assetId", "uhcMspaId", "kind", "source", "sourceHash", "status", "distributionReference"],
        "properties": {
          "assetId": { "type": "string", "minLength": 1 },
          "uhcMspaId": { "type": "string", "pattern": "^\\d{6}$" },
          "kind": { "enum": ["image", "flash", "html5", "interactive"] },
          "source": { "enum": ["uhc-local", "translation-local"] },
          "sourceHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "status": { "enum": ["local-only", "authorized", "blocked"] },
          "distributionReference": { "type": ["string", "null"] }
        }
      }
    }
  }
}
