{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Eldayia/homestuck-fr-uhc/schemas/source-state.schema.json",
  "title": "Homestuck FR UHC source state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "provider", "adventureId", "generatedAt", "pages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "adventureId": { "type": "string", "minLength": 1 },
    "sourceRevision": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pageNumber", "rawHash", "normalizedHash"],
        "properties": {
          "pageNumber": { "type": "integer", "minimum": 1 },
          "rawHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "normalizedHash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "modifiedAt": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
